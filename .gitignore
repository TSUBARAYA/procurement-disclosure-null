# Raw external data (large; download per data/README.md). The transposition
# table is the one shipped file under data/external/.
data/external/*
!data/external/eu_transposition_2014_24.csv

# Derived intermediate caches (regenerated from the raw extracts by the pipeline;
# see docs/manifest.md — nothing in the paper depends on a shipped cache)
analysis/*.csv

