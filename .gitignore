__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Figure tooling (HTML/CDP pipeline superseded by the matplotlib builders)
figures/node_modules/
figures/*.html
figures/*.js
figures/package*.json

# Local-only / submission material (not part of the reproducibility record)
paper/cover_letter.md
paper/_superseded_round2_Does_Transparency.docx
paper/*.pdf
paper/_chk_*.png
paper/Testing_the_Transparency_Competition_Premise.docx

